###############################################################################
# التطبيق
###############################################################################
APP_NAME="Tafra Open LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://fc-admin.test
APP_VERSION=1.0.0

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG
APP_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file
APP_CURRENCY=EGP
BCRYPT_ROUNDS=12

# قائمة CIDR صريحة في الإنتاج لو التطبيق متاح مباشرة — راجع docs/14 بند ١
TRUSTED_PROXIES=*

###############################################################################
# قاعدة البيانات — MySQL 8 / MariaDB 10.6+ (اللي الاستضافة المشتركة بتديه).
# PostgreSQL شغّال كمان: DB_CONNECTION=pgsql و DB_PORT=5432
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=open_lms
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# تعدد المستأجرين (docs/03 بند ١ · docs/24)
###############################################################################
# single = قاعدة واحدة + عمود tenant_id · multi = قاعدة بيانات لكل مؤسسة.
# بيتقفل عند أول نشر بـ `php artisan tenancy:init --mode=...` — تغييره بعدها
# بيوقف التطبيق عن قصد. multi محتاج صلاحية CREATEDB لمستخدم القاعدة (docs/14 بند ٢).
TENANCY_MODE=single
TENANCY_DB_PREFIX=fc_tenant_
# الإنتاج: true — إنشاء قاعدة المؤسسة وتهجيرها في الطابور مش جوه الطلب
TENANCY_PROVISION_QUEUED=false

###############################################################################
# الكاش والطوابير — على القاعدة افتراضياً (استضافة مشتركة، مفيش Redis).
# على VPS فيه Redis: CACHE_STORE=redis و QUEUE_CONNECTION=redis + Horizon،
# و QUEUE_WORKER_VIA_SCHEDULER=false (docs/install/vps.md)
###############################################################################
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

CACHE_STORE=database
CACHE_PREFIX=fc_admin
QUEUE_CONNECTION=database
# عامل الطابور من الجدولة (`queue:work --stop-when-empty` كل دقيقة) — config/installer.php
QUEUE_WORKER_VIA_SCHEDULER=true

# الجلسات في قاعدة البيانات — مطلوب لإنهاء جلسة محددة (docs/12 بند ٢)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

###############################################################################
# البث — Laravel Reverb
###############################################################################
# reverb محتاج عملية دايمة — log على الاستضافة المشتركة
BROADCAST_CONNECTION=log
REVERB_APP_ID=fc-admin
REVERB_APP_KEY=fc-admin-key
REVERB_APP_SECRET=fc-admin-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

###############################################################################
# التخزين — الديسك الفعلي بيتقرر وقت التشغيل من DiskResolver (docs/04)
###############################################################################
FILESYSTEM_DISK=public
MEDIA_DISK=public
MEDIA_QUEUE=media
MEDIA_TEMPORARY_URL_MINUTES=10
# فاضي = <APP_URL>/storage (symlink). المثبّت بيحطه <APP_URL>/uploads لو symlink() مقفول
PUBLIC_STORAGE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fc-admin
AWS_PRIVATE_BUCKET=fc-admin-private
AWS_BACKUP_BUCKET=fc-admin-backups
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# البريد
###############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@futurecode.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# السجلات
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

###############################################################################
# المراقبة
###############################################################################
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

HORIZON_PATH=horizon
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
ACTIVITYLOG_RETENTION_MONTHS=12

HEALTH_FAILED_JOBS_WARN=25
HEALTH_FAILED_JOBS_FAIL=50
HEALTH_ENDPOINT_SECRET=
# أقراص النسخ الاحتياطي (مفصولة بفاصلة). الإنتاج: s3-backups
BACKUP_DISKS=backups-local
BACKUP_ALERT_EMAIL=admin@futurecode.test
BACKUP_ARCHIVE_PASSWORD=

###############################################################################
# الصلاحيات
###############################################################################
PERMISSION_CACHE_TTL="24 hours"
PERMISSION_CACHE_STORE=database

SETTINGS_CACHE_ENABLED=true
SETTINGS_CACHE_STORE=database

###############################################################################
# الأمان
###############################################################################
# CSP بيبدأ في وضع التقرير — حوّله للفرض بعد ما التقارير تنضف (docs/20 بند ٥)
CSP_ENABLED=true
CSP_ENFORCE=false

###############################################################################
# وصول الذكاء الاصطناعي — خادم MCP + OAuth (docs/23)
###############################################################################
# مفتاح طوارئ للبيئة — فوق مفتاح الإعدادات ومفتاح كل مؤسسة
MCP_ENABLED=true
MCP_PATH=mcp
# فريق التشغيل (/central) عن طريق AI — مقفول لحد ما يتاخد قرار
MCP_CENTRAL_ENABLED=false
MCP_ACCESS_TOKEN_MINUTES=60
MCP_REFRESH_TOKEN_DAYS=30
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_WRITE_RATE_LIMIT_PER_MINUTE=10
MCP_REGISTRATIONS_PER_MINUTE=10
MCP_MAX_RESPONSE_BYTES=60000
# روابط الرجوع المسموحة للتسجيل الديناميكي — أي عميل تاني بيتضاف هنا صراحةً
MCP_REDIRECT_DOMAINS="https://claude.ai,https://claude.com,https://chatgpt.com,https://chat.openai.com,http://localhost,http://127.0.0.1"
# مفاتيح توقيع التوكنز — `php artisan passport:keys` (deploy.sh بيعملها لو ناقصة)،
# أو حطها هنا مباشرة في بيئات من غير ملفات (حاويات)
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

###############################################################################
# المحتوى والأونبوردنج
###############################################################################
CONTENT_MAX_PINNED=3
ONBOARDING_ENABLED=true

###############################################################################
# البذور (تطوير فقط)
###############################################################################
SEED_PASSWORD="Password!2026"
DEMO_ROWS=50000

###############################################################################
# النشر
###############################################################################
DEPLOY_SECRET=
DEPLOY_BRANCH=main

# اسم خدمة FPM اللي deploy.sh بيعيد تحميلها.
# لازم يتظبط لو مش php8.4-fpm — مع opcache.validate_timestamps=0
# الاسم الغلط معناه نشر "ناجح" بيقدّم الكود القديم (docs/21 بند ٢٣).
FPM_SERVICE=php8.4-fpm
VITE_APP_NAME="${APP_NAME}"

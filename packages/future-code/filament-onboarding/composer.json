{
    "name": "future-code/filament-onboarding",
    "description": "نظام أونبوردنج كامل للوحات Filament — كود المستقبل",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "FutureCode\\Onboarding\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FutureCode\\Onboarding\\OnboardingServiceProvider"
            ],
            "aliases": {
                "Onboarding": "FutureCode\\Onboarding\\Facades\\Onboarding"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
